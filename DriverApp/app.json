{
  "expo": {
    "name": "Pickyou Driver App",
    "slug": "DriverApp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/icon-1.png",
    "scheme": "driverapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ayeshalexan.DriverApp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-1.png",
        "backgroundColor": "#0B1220"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ayeshalexan.DriverApp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/icon-1.png"
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icon-1.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Pick You to share your location during active rides.",
          "locationWhenInUsePermission": "Allow Pick You to use your location while you are online.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95287dff-3db4-4e4d-b47b-6d2d89a2a84f"
      }
    }
  }
}
