{
  "expo": {
    "name": "PickU Driver",
    "slug": "DriverApp",
    "owner": "hawadmins-team",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon-1.png",
    "scheme": "driverapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.picku.DriverApp"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-1.png",
        "backgroundColor": "#0B1220"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.picku.DriverApp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/icon-1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon-1.png",
          "color": "#00A859"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PickU Driver collects your location, including in the background when the app is closed or not in use, to send you ride requests and share your live location with passengers during active rides.",
          "locationWhenInUsePermission": "Allow Pick You to use your location while you are online.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PickU Driver to access your photos to upload your profile picture and verification documents.",
          "cameraPermission": "Allow PickU Driver to use your camera to capture your profile picture and verification documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96ef6731-3bb7-453a-b09b-4a855fc5bfb3"
      }
    }
  }
}
