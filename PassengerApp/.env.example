# Copy to .env in this folder (PassengerApp/) and fill in your environment values.
# Restart Expo after changes: npx expo start --clear

EXPO_PUBLIC_API_URL=https://picku.lk

GOOGLE_MAPS_ANDROID_API_KEY_PASSENGER=
GOOGLE_MAPS_IOS_API_KEY_PASSENGER=

EXPO_PUBLIC_WS_HOST=picku.lk
EXPO_PUBLIC_WS_PORT=443
EXPO_PUBLIC_WS_SCHEME=https
EXPO_PUBLIC_REVERB_APP_KEY=app-key

EXPO_PUBLIC_DEV_MODE=false
