{
  "expo": {
    "name": "PickU",
    "slug": "PickU",
    "version": "1.1.0",
    "owner": "hawadmins-team",
    "orientation": "portrait",
    "icon": "./assets/images/vehicles/icon.png",
    "scheme": "picku",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.picku.passenger",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "apkType": "universal",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/vehicles/icon.png",
        "backgroundImage": "./assets/images/vehicles/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "lk.picku.passenger",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PickU to use your camera to scan QR codes for Scan & Pay."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Untitled_design.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PickU to use your location to find nearby drivers and set your pickup point."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PickU to access your photos to update your profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b897a048-6b54-4a4c-ad96-c2752067631c"
      }
    }
  }
}
