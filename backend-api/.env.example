APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
AUTH_ALLOW_LEGACY_ROLE_TOKENS=true
AUTH_RATE_LIMIT_PER_MINUTE=10

NOTIFYLK_URL=https://app.notify.lk/api/v1/send
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=

GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_COUNTRY=lk
GOOGLE_MAPS_REGION=LK
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_TIMEOUT_SECONDS=8
GOOGLE_MAPS_ROUTE_CACHE_TTL_SECONDS=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pick_you
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use reverb so RideRequestedTargeted reaches driver apps (not "log")
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
# Ride timeouts & matching use Redis queues — run: php artisan queue:work
QUEUE_CONNECTION=redis
SANCTUM_CACHE_TTL_SECONDS=300

# Ride matching
RIDE_DRIVER_OFFER_SECONDS=12
RIDE_MATCH_RADIUS_KM=10
RIDE_MATCH_MAX_DRIVERS=50
RIDE_REJECTION_COOLDOWN_SECONDS=300
RIDE_REDIS_MATCHING_TTL=720
RIDE_REDIS_CURRENT_DRIVER_TTL=42

# Queue worker names (run separate workers per queue — see deploy/supervisor/)
QUEUE_RIDES=rides
QUEUE_NOTIFICATIONS=notifications
QUEUE_LOCATIONS=locations
REDIS_QUEUE=default

# Live driver location
LOCATION_LATEST_TTL_SECONDS=60
LOCATION_STALE_AFTER_SECONDS=20
LOCATION_SNAPSHOT_INTERVAL_SECONDS=30
LOCATION_GEO_KEY=drivers:online:geo

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
